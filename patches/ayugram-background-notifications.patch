+
+// The pages inside Settings → AyuGram categories that are not older screens.
+
+private func symbol(_ name: String, _ color: UInt32) -> UIImage? {
+    return AyuSettingsIcons.symbol(name, color: UIColor(rgb: color))
+}
+
+/// A generic page: rows built from the current settings, taps and toggles handled by closures.
+private func ayuPage(context: AccountContext, title: @escaping (Bool) -> String, notifications: [Notification.Name], entries: @escaping (Bool) -> [AyuSectionedEntry], open: @escaping (Int32, @escaping (ViewController) -> Void, @escaping (UIViewController) -> Void) -> Void, toggle: @escaping (Int32, Bool) -> Void) -> ViewController {
+    var push: ((ViewController) -> Void)?
+    let present: (UIViewController) -> Void = { context.sharedContext.applicationBindings.presentNativeController($0) }
+    let arguments = AyuSectionedArguments(open: { id in
+        open(id, { push?($0) }, present)
+    }, toggle: { id, value in
+        toggle(id, value)
+        NotificationCenter.default.post(name: ayuLocalSettingsChanged, object: nil)
+    })
+    let signal = combineLatest(ayuSettingsPresentationData(context: context), ayuChanges(notifications + [ayuLocalSettingsChanged, AyuExtras.didChangeNotification, AyuMediaSettings.didChangeNotification]))
+    |> deliverOnMainQueue
+    |> map { presentationData, _ -> (ItemListControllerState, (ItemListNodeState, Any)) in
+        let ru = presentationData.strings.baseLanguageCode.hasPrefix("ru")
+        let data = ItemListPresentationData(presentationData)
+        let state = ItemListControllerState(presentationData: data, title: .text(title(ru)), leftNavigationButton: nil, rightNavigationButton: nil, backNavigationButton: ItemListBackButton(title: presentationData.strings.Common_Back))
+        return (state, (ItemListNodeState(presentationData: data, entries: entries(ru), style: .blocks, animateChanges: false), arguments))
+    }
+    let controller = ItemListController(context: context, state: signal)
+    push = { [weak controller] in controller?.push($0) }
+    return controller
+}
+
+/// A choice sheet (alert style, safe on iPad).
+private func ayuChoose<T>(_ present: (UIViewController) -> Void, title: String, ru: Bool, options: [T], current: T, label: (T) -> String, equal: (T, T) -> Bool, pick: @escaping (T) -> Void) {
+    let alert = UIAlertController(title: title, message: nil, preferredStyle: .alert)
+    for option in options {
+        alert.addAction(UIAlertAction(title: (equal(option, current) ? "✓ " : "") + label(option), style: .default, handler: { _ in
+            pick(option)
+            NotificationCenter.default.post(name: ayuLocalSettingsChanged, object: nil)
+        }))
+    }
+    alert.addAction(UIAlertAction(title: ru ? "Отмена" : "Cancel", style: .cancel))
+    present(alert)
+}
