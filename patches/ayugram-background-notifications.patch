+            .info(3, 23, ru ? "Местное время. Одинаковое начало и конец — без звука весь день." : "Local time. Equal start and end means silent all day."),
+            .header(4, 30, ru ? "СОДЕРЖИМОЕ" : "CONTENT"),
+            .toggle(4, 31, nil, ru ? "Уведомлять об удалённых" : "Notify about deletions", nil, AyuExtras.isOn(.notifyDeleted)),
+            .toggle(4, 32, nil, ru ? "Уведомлять об изменённых" : "Notify about edits", nil, UserDefaults.standard.bool(forKey: "ayu.extra.notifyEdited")),
+            .toggle(4, 33, nil, ru ? "Только по ключевым словам" : "Only matching keywords", nil, settings.filterEnabled),
+            .link(4, 34, nil, ru ? "Ключевые слова" : "Keywords", "\(settings.keywords.count)"),
+            .info(4, 35, ru ? "Слова или фразы через запятую. Пустой список при включённом фильтре блокирует все уведомления. Настройки Telegram для чатов и тем сохраняют силу." : "Comma-separated words or phrases. An empty enabled filter blocks all notifications. Telegram chat and topic notification settings still apply.")
+        ]
+    }, open: { id, _, present in
+        let ru = ayuIsRussian(context)
+        let settings = AyuLocalNotificationSettings()
+        guard id == 22 || id == 34 else { return }
+        let alert = UIAlertController(title: id == 22 ? (ru ? "Тихие часы · HH:MM" : "Quiet hours · HH:MM") : (ru ? "Ключевые слова" : "Keywords"), message: nil, preferredStyle: .alert)
+        alert.addTextField { field in
+            field.text = id == 22 ? AyuLocalNotificationSettings.clock(settings.quietStart) : settings.keywords.joined(separator: ", ")
+            field.placeholder = id == 22 ? "23:00" : (ru ? "слово, фраза" : "word, phrase")
+            field.autocapitalizationType = .none
+        }
+        if id == 22 { alert.addTextField { $0.text = AyuLocalNotificationSettings.clock(settings.quietEnd); $0.placeholder = "08:00" } }
+        alert.addAction(UIAlertAction(title: ru ? "Отмена" : "Cancel", style: .cancel))
+        alert.addAction(UIAlertAction(title: ru ? "Сохранить" : "Save", style: .default, handler: { [weak alert] _ in
+            let first = alert?.textFields?.first?.text ?? ""
+            if id == 22 {
+                guard let start = AyuLocalNotificationSettings.minute(first), let end = AyuLocalNotificationSettings.minute(alert?.textFields?.last?.text ?? "") else {
+                    let error = UIAlertController(title: ru ? "Введите время от 00:00 до 23:59" : "Enter a time from 00:00 to 23:59", message: nil, preferredStyle: .alert)
+                    error.addAction(UIAlertAction(title: "OK", style: .default)); present(error); return
+                }
+                UserDefaults.standard.set(start, forKey: AyuLocalNotificationSettings.prefix + "quietStart")
+                UserDefaults.standard.set(end, forKey: AyuLocalNotificationSettings.prefix + "quietEnd")
+            } else {
+                UserDefaults.standard.set(String(first.prefix(4096)), forKey: AyuLocalNotificationSettings.prefix + "keywords")
+            }
+            NotificationCenter.default.post(name: ayuLocalSettingsChanged, object: nil)
+        }))
+        present(alert)
+    }, toggle: { id, value in
+        if id == 1 {
+            try? context.account.network.ayuGhostMode.update { $0.interface.backgroundNotifications = value }
+            // Without the system permission no banner is ever shown, so ask when the user turns it on.
+            if value {
+                UNUserNotificationCenter.current().requestAuthorization(options: [.alert, .sound, .badge], completionHandler: { _, _ in })
+            }
+            NotificationCenter.default.post(name: ayuLocalSettingsChanged, object: nil)
+            return
+        }
+        if id == 3 { AyuBackgroundKeepAliveSetting.isEnabled = value; return }
+        if id == 31 { AyuExtras.set(.notifyDeleted, value); return }
+        if id == 32 { UserDefaults.standard.set(value, forKey: "ayu.extra.notifyEdited"); return }
+        if let key = [11: "groupByChat", 12: "avatars", 13: "actions", 21: "quietHours", 33: "filterEnabled"][Int(id)] {
+            UserDefaults.standard.set(value, forKey: AyuLocalNotificationSettings.prefix + key)
+        }
+    })
+}
