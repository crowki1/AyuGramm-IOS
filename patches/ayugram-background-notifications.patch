diff --git a/submodules/TelegramUI/Sources/AyuBackgroundKeepAlive.swift b/submodules/TelegramUI/Sources/AyuBackgroundKeepAlive.swift
new file mode 100644
index 00000000..4edd7313
--- /dev/null
+++ b/submodules/TelegramUI/Sources/AyuBackgroundKeepAlive.swift
@@ -0,0 +1,89 @@
+import Foundation
+import UIKit
+import AVFoundation
+import Display
+import SwiftSignalKit
+import TelegramAudio
+import UniversalMediaPlayer
+
+/// Sideloaded builds never receive APNs, so local notifications only appear while the app is
+/// still awake. Holding the audio session alone is not enough: `SharedWakeupManager` keeps the
+/// network transactions running only while `hasActiveAudioSession` is true, and that flag is
+/// driven solely by `MediaManagerImpl.globalAudioSession`. So the keep-alive registers a silent
+/// renderer there, exactly like the music player does, which keeps both the process and the
+/// MTProto connection alive — messages arrive and become local notifications.
+///
+/// The cost is battery, which the settings screen states plainly.
+public final class AyuBackgroundKeepAlive {
+    public static let shared = AyuBackgroundKeepAlive()
+
+    private var renderer: MediaPlayerAudioRenderer?
+    private var audioSessionDisposable: Disposable?
+    private var observers: [NSObjectProtocol] = []
+
+    private init() {
+        let center = NotificationCenter.default
+        self.observers.append(center.addObserver(forName: UIApplication.didEnterBackgroundNotification, object: nil, queue: .main, using: { [weak self] _ in
+            self?.apply()
+        }))
+        self.observers.append(center.addObserver(forName: UIApplication.didBecomeActiveNotification, object: nil, queue: .main, using: { [weak self] _ in
+            self?.apply()
+        }))
+        self.observers.append(center.addObserver(forName: AyuBackgroundKeepAliveSetting.didChangeNotification, object: nil, queue: .main, using: { [weak self] _ in
+            self?.apply()
+        }))
+        self.observers.append(center.addObserver(forName: AVAudioSession.interruptionNotification, object: nil, queue: .main, using: { [weak self] notification in
+            guard let raw = notification.userInfo?[AVAudioSessionInterruptionTypeKey] as? UInt,
+                  AVAudioSession.InterruptionType(rawValue: raw) == .ended else { return }
+            self?.apply()
+        }))
+    }
+
+    /// Runs only in the background: in the foreground iOS keeps the app alive anyway, and holding
+    /// a playback session there would take audio away from other apps.
+    public func apply() {
+        guard AyuBackgroundKeepAliveSetting.isEnabled, UIApplication.shared.applicationState != .active else {
+            self.stop()
+            return
+        }
+        self.start()
+    }
+
+    private func start() {
+        guard self.renderer == nil else { return }
+        let audioSession = MediaManagerImpl.globalAudioSession
+        self.audioSessionDisposable = audioSession.push(
+            audioSessionType: .ambient,
+            once: false,
+            manualActivate: { control in
+                control.setupAndActivate(synchronous: false, { _ in })
+            },
+            deactivate: { _ in
+                return .complete()
+            }
+        )
+        let renderer = MediaPlayerAudioRenderer(
+            audioSession: .manager(audioSession),
+            forAudioVideoMessage: false,
+            playAndRecord: false,
+            useVoiceProcessingMode: false,
+            soundMuted: true,
+            ambient: true,
+            mixWithOthers: true,
+            forceAudioToSpeaker: false,
+            baseRate: 1.0,
+            audioLevelPipe: ValuePipe(),
+            updatedRate: {},
+            audioPaused: {}
+        )
+        self.renderer = renderer
+        renderer.start()
+    }
+
+    private func stop() {
+        self.renderer?.stop()
+        self.renderer = nil
+        self.audioSessionDisposable?.dispose()
+        self.audioSessionDisposable = nil
+    }
+}
