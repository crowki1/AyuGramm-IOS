+/// Media → Video messages → Mask studio: Core Image layers applied in order.
+func ayuMaskStudioController(context: AccountContext) -> ViewController {
+    let filters = AyuMediaSettings.studioFilters
+    return ayuPage(context: context, title: { $0 ? "Студия масок" : "Mask studio" }, notifications: [], entries: { ru in
+        let layers = AyuMediaSettings.studioLayers
+        var entries: [AyuSectionedEntry] = [.header(1, 0, ru ? "СЛОИ ФИЛЬТРОВ" : "FILTER LAYERS")]
+        for (index, filter) in filters.enumerated() {
+            let position = layers.firstIndex(of: filter.name).map { " · \($0 + 1)" } ?? ""
+            entries.append(.toggle(1, Int32(index + 1), nil, (ru ? filter.ru : filter.en) + position, nil, layers.contains(filter.name)))
+        }
+        entries.append(.info(1, 99, ru ? "Включённые слои накладываются на кружок по порядку включения, поверх выбранной маски. До 8 слоёв." : "Layers apply to the video message in the order they were switched on, over the chosen mask. Up to 8 layers."))
+        return entries
+    }, open: { _, _, _ in }, toggle: { id, value in
+        let index = Int(id) - 1
+        guard index >= 0, index < filters.count else { return }
+        var layers = AyuMediaSettings.studioLayers
+        layers.removeAll(where: { $0 == filters[index].name })
+        if value { layers.append(filters[index].name) }
+        AyuMediaSettings.studioLayers = layers
+        if value { AyuMediaSettings.masksEnabled = true }
+    })
+}
