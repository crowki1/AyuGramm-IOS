+/// Runs `open` after Face ID / Touch ID (or the device passcode) when AyuGram settings are locked.
+public func ayuOpenSettingsAuthenticated(context: AccountContext, _ open: @escaping () -> Void) {
+    guard AyuExtras.isOn(.lockAyuSettings) else { return open() }
+    let authentication = LAContext()
+    var error: NSError?
+    guard authentication.canEvaluatePolicy(.deviceOwnerAuthentication, error: &error) else { return open() }
+    let ru = ayuIsRussian(context)
+    authentication.evaluatePolicy(.deviceOwnerAuthentication, localizedReason: ru ? "Откройте настройки Umogram" : "Open Umogram settings", reply: { success, _ in
+        if success {
+            DispatchQueue.main.async(execute: open)
+        }
+    })
+}
