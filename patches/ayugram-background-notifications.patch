+/// Settings → AyuGram is organised in six categories (Privacy, Messages, Media & Calls,
+/// Appearance, Security, More). Each category page links the screens that belong to it.
+enum AyuCategory: Int32, CaseIterable {
+    case privacy = 51
+    case messages = 52
+    case media = 53
+    case appearance = 54
+    case security = 55
+    case more = 56
+
+    func title(_ ru: Bool) -> String {
+        switch self {
+        case .privacy: return ru ? "Приватность" : "Privacy"
+        case .messages: return ru ? "Сообщения" : "Messages"
+        case .media: return ru ? "Медиа и звонки" : "Media & Calls"
+        case .appearance: return ru ? "Оформление" : "Appearance"
+        case .security: return ru ? "Безопасность" : "Security"
+        case .more: return ru ? "Ещё" : "More"
+        }
+    }
+
+    func subtitle(_ ru: Bool) -> String {
+        switch self {
+        case .privacy: return ru ? "Что о вас видят другие" : "What others see about you"
+        case .messages: return ru ? "Что хранится, отправляется и показывается" : "What is kept, sent and shown"
+        case .media: return ru ? "Голос, кружки, звонки и загрузки" : "Voice, video messages, calls and downloads"
+        case .appearance: return ru ? "Сообщения, список чатов, панели и иконки" : "Messages, chat list, panels and icons"
+        case .security: return ru ? "Защита чатов, код-пароль и аккаунты" : "Chat protection, passcode and accounts"
+        case .more: return ru ? "Плагины, инструменты, бейджи, настройки Umogram" : "Plugins, tools, badges, Umogram settings"
+        }
+    }
+
+    var icon: UIImage? {
+        switch self {
+        case .privacy: return AyuSettingsIcons.ghost(color: UIColor(rgb: 0x8E5CF7))
+        case .messages: return AyuSettingsIcons.symbol("bubble.left.fill", color: UIColor(rgb: 0x007AFF))
+        case .media: return AyuSettingsIcons.symbol("photo.on.rectangle.angled", color: UIColor(rgb: 0x34C759))
+        case .appearance: return AyuSettingsIcons.symbol("paintbrush.pointed.fill", color: UIColor(rgb: 0xFF2D55))
+        case .security: return AyuSettingsIcons.symbol("lock.fill", color: UIColor(rgb: 0xFF9500))
+        case .more: return AyuSettingsIcons.symbol("ellipsis", color: UIColor(rgb: 0x5856D6))
+        }
+    }
+}
