+import Foundation
+import UIKit
+import Display
+import SwiftSignalKit
+import TelegramCore
+import TelegramPresentationData
+import TelegramUIPreferences
+import PresentationDataUtils
+import ItemListUI
+import AccountContext
+
+private struct AyuAppearanceDraft: Equatable {
+    var deleted: String
+    var edited: String
+}
+
+private struct AyuAppearanceArguments {
+    let context: AccountContext
+    let toggle: (Int32, Bool) -> Void
+    let text: (Int32, String) -> Void
+    let style: (AyuAppearanceSettings.DeletedMarkStyle) -> Void
+    let save: () -> Void
+    let reset: () -> Void
+}
+
+private enum AyuAppearanceEntry: ItemListNodeEntry {
+    case preview(AyuAppearanceSettings, PresentationTheme, TelegramWallpaper, PresentationFontSize, PresentationChatBubbleCorners, PresentationDateTimeFormat, PresentationPersonNameOrder, [ChatPreviewMessageItem])
+    case header(Int32, String)
+    case toggle(Int32, String, Bool)
+    case style(Int32, AyuAppearanceSettings.DeletedMarkStyle, String, Bool)
+    case input(Int32, String, String)
+    case action(Int32, String)
+    case info(Int32, String)
+
+    var stableId: Int32 {
+        switch self {
+        case .preview: return -1
+        case let .header(id, _), let .toggle(id, _, _), let .style(id, _, _, _), let .input(id, _, _), let .action(id, _), let .info(id, _): return id
+        }
+    }
+
+    var section: ItemListSectionId {
+        switch self.stableId {
+        case ...0: return 0
+        case 1 ... 9: return 1
+        case 10 ... 19: return 2
+        case 20 ... 29: return 3
+        default: return 4
+        }
+    }
+
+    static func < (lhs: AyuAppearanceEntry, rhs: AyuAppearanceEntry) -> Bool { return lhs.stableId < rhs.stableId }
+
+    func item(presentationData: ItemListPresentationData, arguments: Any) -> ListViewItem {
+        let arguments = arguments as! AyuAppearanceArguments
+        switch self {
+        case let .preview(_, theme, wallpaper, fontSize, corners, dateTimeFormat, nameOrder, items):
+            return ThemeSettingsChatPreviewItem(context: arguments.context, systemStyle: .glass, theme: theme, componentTheme: theme, strings: presentationData.strings, sectionId: self.section, fontSize: fontSize, chatBubbleCorners: corners, wallpaper: wallpaper, dateTimeFormat: dateTimeFormat, nameDisplayOrder: nameOrder, messageItems: items)
+        case let .header(_, text):
+            return ItemListSectionHeaderItem(presentationData: presentationData, text: text, sectionId: self.section)
+        case let .toggle(id, title, value):
+            return ItemListSwitchItem(presentationData: presentationData, systemStyle: .glass, title: title, value: value, sectionId: self.section, style: .blocks, updated: { arguments.toggle(id, $0) })
+        case let .style(_, style, title, checked):
+            return ItemListCheckboxItem(presentationData: presentationData, systemStyle: .glass, title: title, style: .right, checked: checked, zeroSeparatorInsets: false, sectionId: self.section, action: { arguments.style(style) })
+        case let .input(id, text, placeholder):
+            return ItemListSingleLineInputItem(presentationData: presentationData, systemStyle: .glass, title: NSAttributedString(string: ""), text: text, placeholder: placeholder, type: .regular(capitalization: false, autocorrection: false), returnKeyType: .done, spacing: 0.0, clearType: .always, maxLength: 24, sectionId: self.section, textUpdated: { arguments.text(id, $0) }, action: arguments.save)
+        case let .action(id, title):
+            return ItemListActionItem(presentationData: presentationData, systemStyle: .glass, title: title, kind: .generic, alignment: .natural, sectionId: self.section, style: .blocks, action: id == 30 ? arguments.save : arguments.reset)
+        case let .info(_, text):
+            return ItemListTextItem(presentationData: presentationData, text: .plain(text), sectionId: self.section)
+        }
+    }
+
+    static func == (lhs: AyuAppearanceEntry, rhs: AyuAppearanceEntry) -> Bool {
+        switch (lhs, rhs) {
+        case let (.preview(la, lt, lw, lf, lc, ld, ln, li), .preview(ra, rt, rw, rf, rc, rd, rn, ri)):
+            return la == ra && lt === rt && lw == rw && lf == rf && lc == rc && ld == rd && ln == rn && li == ri
+        case let (.header(li, lt), .header(ri, rt)): return li == ri && lt == rt
+        case let (.toggle(li, lt, lv), .toggle(ri, rt, rv)): return li == ri && lt == rt && lv == rv
+        case let (.style(li, ls, lt, lc), .style(ri, rs, rt, rc)): return li == ri && ls == rs && lt == rt && lc == rc
+        case let (.input(li, lt, lp), .input(ri, rt, rp)): return li == ri && lt == rt && lp == rp
+        case let (.action(li, lt), .action(ri, rt)): return li == ri && lt == rt
+        case let (.info(li, lt), .info(ri, rt)): return li == ri && lt == rt
+        default: return false
+        }
+    }
+}
+
+public func ayuAppearanceController(context: AccountContext) -> ViewController {
+    let store = context.account.network.ayuGhostMode
+    let initial = store.current.appearance
+    let initialDraft = AyuAppearanceDraft(deleted: initial.deletedMark, edited: initial.editedMark)
+    let draftText = Atomic(value: initialDraft)
+    let draft = ValuePromise(initialDraft, ignoreRepeated: true)
+    var presentError: ((Error) -> Void)?
+    var finishEditing: (() -> Void)?
+    let arguments = AyuAppearanceArguments(context: context, toggle: { id, value in
+        do {
+            try store.update {
+                if id == 3 { $0.appearance.showGhostButton = value }
+                if id == 2 { $0.appearance.showMessageSeconds = value }
+            }
+        } catch { presentError?(error) }
+    }, text: { id, text in
+        let updated = draftText.modify { previous in
+            var updated = previous
+            if id == 14 { updated.deleted = text }
+            if id == 21 { updated.edited = text }
+            return updated
+        }
+        draft.set(updated)
+    }, style: { style in
+        do {
+            try store.update { $0.appearance.deletedMarkStyle = style }
+        } catch { presentError?(error) }
+    }, save: {
+        let text = draftText.with { $0 }
+        do {
+            try store.update {
+                $0.appearance.deletedMark = text.deleted
+                $0.appearance.editedMark = text.edited
+            }
+            let appearance = store.current.appearance
+            let saved = AyuAppearanceDraft(deleted: appearance.deletedMark, edited: appearance.editedMark)
+            let _ = draftText.swap(saved)
+            draft.set(saved)
+            finishEditing?()
+        } catch { presentError?(error) }
+    }, reset: {
+        do {
+            try store.update { $0.appearance = AyuAppearanceSettings() }
+            let cleared = AyuAppearanceDraft(deleted: "", edited: "")
+            let _ = draftText.swap(cleared)
+            draft.set(cleared)
+            finishEditing?()
+        } catch { presentError?(error) }
+    })
+    let signal = combineLatest(context.sharedContext.presentationData, store.signal, draft.get())
+    |> deliverOnMainQueue
+    |> map { presentationData, settings, text -> (ItemListControllerState, (ItemListNodeState, Any)) in
+        let ru = presentationData.strings.baseLanguageCode.hasPrefix("ru")
+        let appearance = settings.appearance
+        let unsaved = text.deleted != appearance.deletedMark || text.edited != appearance.editedMark
+        let previewItems = [
+            ChatPreviewMessageItem(outgoing: false, reply: nil, text: AyuStrings.sendMeWiFiPasswordLater.text(ru), nameColor: .preset(.blue), backgroundEmojiId: nil, ayuDeleted: true),
+            ChatPreviewMessageItem(outgoing: true, reply: nil, text: AyuStrings.changedMyMind.text(ru), nameColor: .preset(.blue), backgroundEmojiId: nil, ayuEdited: true)
+        ]
+        var entries: [AyuAppearanceEntry] = [
+            .preview(appearance, presentationData.theme, presentationData.chatWallpaper, presentationData.chatFontSize, presentationData.chatBubbleCorners, presentationData.dateTimeFormat, presentationData.nameDisplayOrder, previewItems),
+            .header(1, "UMOGRAM"),
+            .toggle(2, AyuStrings.secondsMessageTimestamps.text(ru), appearance.showMessageSeconds),
+            .toggle(3, AyuStrings.ghostButtonChatHeader.text(ru), appearance.showGhostButton),
+            .header(10, AyuStrings.deletedMessageMark.text(ru)),
+            .style(11, .text, AyuStrings.textText.text(ru), appearance.deletedMarkStyle == .text),
+            .style(12, .trash, AyuStrings.trash.text(ru), appearance.deletedMarkStyle == .trash),
+            .style(13, .eye, AyuStrings.eye.text(ru), appearance.deletedMarkStyle == .eye)
+        ]
+        if appearance.deletedMarkStyle == .text {
+            entries.append(.input(14, text.deleted, AyuStrings.deleted.text(ru)))
+        }
+        entries.append(.header(20, AyuStrings.editedMessageMark.text(ru)))
+        entries.append(.input(21, text.edited, presentationData.strings.Conversation_MessageEditedLabel))
+        entries.append(.action(30, ru ? (unsaved ? "Сохранить метки •" : "Сохранить метки") : (unsaved ? "Save labels •" : "Save labels")))
+        entries.append(.action(31, AyuStrings.resetChatAppearance.text(ru)))
+        entries.append(.info(32, AyuStrings.emptyFieldUsesStandardLabelText.text(ru)))
+        let data = ItemListPresentationData(presentationData)
+        let state = ItemListControllerState(presentationData: data, title: .text(AyuStrings.chatAppearance.text(ru)), leftNavigationButton: nil, rightNavigationButton: nil, backNavigationButton: ItemListBackButton(title: presentationData.strings.Common_Back))
+        return (state, (ItemListNodeState(presentationData: data, entries: entries, style: .blocks, animateChanges: false), arguments))
+    }
+    let controller = ItemListController(context: context, state: signal)
+    finishEditing = { [weak controller] in let _ = controller?.view.endEditing(true) }
+    presentError = { [weak controller] error in
+        let data = context.sharedContext.currentPresentationData.with { $0 }
+        let ru = data.strings.baseLanguageCode.hasPrefix("ru")
+        let text: String
+        if (error as NSError).domain == "AyuAppearance" {
+            text = ru ? "Используй одну строку до 24 символов и 96 байт, без управляющих символов." : error.localizedDescription
+        } else {
+            text = AyuStrings.chatAppearanceCouldNotSaved.text(ru)
+        }
+        controller?.present(textAlertController(context: context, title: "Umogram", text: text, actions: [TextAlertAction(type: .defaultAction, title: data.strings.Common_OK, action: {})]), in: .window(.root))
+    }
+    return controller
+}
