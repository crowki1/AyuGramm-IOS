+/// One row of a category page: a title, a subtitle and what it opens.
+struct AyuCategoryItem {
+    let id: Int32
+    let symbol: String
+    let color: UInt32
+    let titleRu: String
+    let titleEn: String
+    let subtitleRu: String
+    let subtitleEn: String
+    let open: (AccountContext, @escaping (ViewController) -> Void) -> Void
+    var imageName: String? = nil
+
+    var icon: UIImage? {
+        if let imageName {
+            return AyuSettingsIcons.glyph(imageName, color: UIColor(rgb: color), side: imageName.hasPrefix("AyuGram/") ? 20.0 : nil)
+        }
+        return AyuSettingsIcons.symbol(symbol, color: UIColor(rgb: color))
+    }
+}
