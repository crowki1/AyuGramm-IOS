+func ayuCategoryController(context: AccountContext, category: AyuCategory) -> ViewController {
+    var push: ((ViewController) -> Void)?
+    let items = ayuCategoryItems(category)
+    let arguments = AyuSectionedArguments(open: { id in
+        guard let item = items.first(where: { $0.id == id }) else { return }
+        item.open(context, { push?($0) })
+    }, toggle: { _, _ in }, context: context)
+    let signal = ayuSettingsPresentationData(context: context)
+    |> deliverOnMainQueue
+    |> map { presentationData -> (ItemListControllerState, (ItemListNodeState, Any)) in
+        let ru = presentationData.strings.baseLanguageCode.hasPrefix("ru")
+        var entries: [AyuSectionedEntry] = []
+        // Telegram's own bubbles, drawn the way the chat draws AyuGram's marks.
+        if category == .messages {
+            entries.append(.chat(0, 0, AyuSectionedChatPreview(presentationData: presentationData, messages: [
+                ChatPreviewMessageItem(outgoing: false, reply: nil, text: ru ? "Это сообщение удалили, а оно осталось" : "This message was deleted, yet it stayed", nameColor: .preset(.blue), backgroundEmojiId: nil, ayuDeleted: true),
+                ChatPreviewMessageItem(outgoing: true, reply: nil, text: ru ? "А это я исправил — история правок сохранена" : "And this one I edited; its history is kept", nameColor: .preset(.blue), backgroundEmojiId: nil, ayuEdited: true)
+            ])))
+        } else if category == .privacy {
+            let ghost = context.account.network.ayuGhostMode.current.isActive
+            entries.append(.chat(0, 0, AyuSectionedChatPreview(presentationData: presentationData, messages: [
+                ChatPreviewMessageItem(outgoing: false, reply: nil, text: ru ? "Ты тут? Не вижу, что ты онлайн 👀" : "Are you there? I can't see you online 👀", nameColor: .preset(.blue), backgroundEmojiId: nil),
+                ChatPreviewMessageItem(outgoing: true, reply: nil, text: ghost ? (ru ? "Читаю, но меня не видно 👻" : "Reading, but nobody sees me 👻") : (ru ? "Включи режим призрака — и не увидишь" : "Turn ghost mode on and you won't"), nameColor: .preset(.blue), backgroundEmojiId: nil)
+            ])))
+        }
+        for item in items {
+            let subtitle = ru ? item.subtitleRu : item.subtitleEn
+            entries.append(.link(1, item.id, item.icon, ru ? item.titleRu : item.titleEn, subtitle))
+        }
+        let data = ItemListPresentationData(presentationData)
+        let state = ItemListControllerState(presentationData: data, title: .text(category.title(ru)), leftNavigationButton: nil, rightNavigationButton: nil, backNavigationButton: ItemListBackButton(title: presentationData.strings.Common_Back))
+        return (state, (ItemListNodeState(presentationData: data, entries: entries, style: .blocks, animateChanges: false), arguments))
+    }
+    let controller = ItemListController(context: context, state: signal)
+    push = { [weak controller] in controller?.push($0) }
+    return controller
+}
