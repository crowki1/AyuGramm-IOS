+import Foundation
+import UIKit
+import AVFoundation
+
+/// Sideloaded builds never receive APNs, so local notifications only appear while the app is
+/// still awake. iOS suspends a backgrounded app within seconds unless it holds a background
+/// mode, so this plays an inaudible looping track through an `audio` session to stay resident.
+/// The trade-off is battery, which the settings screen states plainly.
+public final class AyuBackgroundKeepAlive {
+    public static let shared = AyuBackgroundKeepAlive()
+
+    public static let didChangeNotification = Notification.Name("AyuGram.BackgroundKeepAliveChanged")
+
+    private static let key = "ayu.notifications.keepAlive"
+
+    private var player: AVAudioPlayer?
+    private var audioURL: URL?
+    private var observers: [NSObjectProtocol] = []
+
+    public var isEnabled: Bool {
+        get { UserDefaults.standard.bool(forKey: Self.key) }
+        set {
+            UserDefaults.standard.set(newValue, forKey: Self.key)
+            self.apply()
+            NotificationCenter.default.post(name: Self.didChangeNotification, object: nil)
+        }
+    }
+
+    private init() {
+        let center = NotificationCenter.default
+        self.observers.append(center.addObserver(forName: UIApplication.didEnterBackgroundNotification, object: nil, queue: .main, using: { [weak self] _ in
+            self?.apply()
+        }))
+        self.observers.append(center.addObserver(forName: UIApplication.didBecomeActiveNotification, object: nil, queue: .main, using: { [weak self] _ in
+            self?.apply()
+        }))
+        self.observers.append(center.addObserver(forName: AVAudioSession.interruptionNotification, object: nil, queue: .main, using: { [weak self] notification in
+            guard let raw = notification.userInfo?[AVAudioSessionInterruptionTypeKey] as? UInt,
+                  AVAudioSession.InterruptionType(rawValue: raw) == .ended else { return }
+            self?.apply()
+        }))
+    }
+
+    /// Starts or stops the silent track to match the setting and the app's state. Being in the
+    /// foreground is not a reason to hold the session: iOS suspends there on its own anyway.
+    public func apply() {
+        guard self.isEnabled, UIApplication.shared.applicationState != .active else {
+            self.stop()
+            return
+        }
+        self.start()
+    }
+
+    private func start() {
+        guard self.player?.isPlaying != true else { return }
+        do {
+            let session = AVAudioSession.sharedInstance()
+            try session.setCategory(.playback, mode: .default, options: [.mixWithOthers])
+            try session.setActive(true)
+            if let player = self.player {
+                _ = player.play()
+                return
+            }
+            let url = try self.makeSilentTrack()
+            let player = try AVAudioPlayer(contentsOf: url)
+            player.numberOfLoops = -1
+            player.volume = 0.0
+            player.prepareToPlay()
+            _ = player.play()
+            self.player = player
+        } catch {
+            self.player = nil
+        }
+    }
+
+    private func stop() {
+        guard let player = self.player else { return }
+        player.stop()
+        self.player = nil
+        try? AVAudioSession.sharedInstance().setActive(false, options: [.notifyOthersOnDeactivation])
+    }
+
+    /// A one-second 8 kHz mono WAV of digital silence, written once to the caches directory.
+    /// Generating it avoids shipping an audio asset that reviewers would have to explain.
+    private func makeSilentTrack() throws -> URL {
+        if let url = self.audioURL, FileManager.default.fileExists(atPath: url.path) {
+            return url
+        }
+        let directory = FileManager.default.urls(for: .cachesDirectory, in: .userDomainMask)[0]
+        let url = directory.appendingPathComponent("ayu-silence.wav")
+        if !FileManager.default.fileExists(atPath: url.path) {
+            let sampleRate: UInt32 = 8000
+            let sampleCount: UInt32 = sampleRate
+            let dataBytes = sampleCount * 2
+            var data = Data()
+            func append32(_ value: UInt32) { withUnsafeBytes(of: value.littleEndian) { data.append(contentsOf: $0) } }
+            func append16(_ value: UInt16) { withUnsafeBytes(of: value.littleEndian) { data.append(contentsOf: $0) } }
+            data.append(contentsOf: Array("RIFF".utf8))
+            append32(36 + dataBytes)
+            data.append(contentsOf: Array("WAVEfmt ".utf8))
+            append32(16)
+            append16(1)
+            append16(1)
+            append32(sampleRate)
+            append32(sampleRate * 2)
+            append16(2)
+            append16(16)
+            data.append(contentsOf: Array("data".utf8))
+            append32(dataBytes)
+            data.append(Data(count: Int(dataBytes)))
+            try data.write(to: url, options: .atomic)
+        }
+        self.audioURL = url
+        return url
+    }
+}
