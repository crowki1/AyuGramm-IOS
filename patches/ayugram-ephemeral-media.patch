+/// AyuGram labels for archived files: circles, plain videos and photos get readable
+/// names instead of a generic "attachment".
+private func ayuAttachmentDisplayName(for file: TelegramMediaFile) -> String {
+    var isRound = false
+    let isVideo = file.mimeType.hasPrefix("video/")
+    for attribute in file.attributes {
+        if case let .Video(_, _, flags, _, _, _) = attribute, flags.contains(.instantRoundVideo) {
+            isRound = true
+        }
+    }
+    if isRound { return "circle.mp4" }
+    if isVideo { return "video.mp4" }
+    return file.fileName ?? "attachment"
+}
