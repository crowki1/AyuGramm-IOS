+/// View-once media («disappearing» photos, videos and circles): Telegram keeps the original
+/// media inside the anchor message until the server confirms deletion. Capture the cached file
+/// into the media archive in the same transaction, before `deleteEphemeralMessages` runs. No
+/// tombstone is created — the message disappears as usual; the copy is listed in Message History
+/// and the Media Archive.
+func ayuArchiveEphemeralMessages(transaction: Transaction, mediaBox: MediaBox, peerId: PeerId, replacementIds: Set<Int32>) {
+    guard mediaBox.isMainProcess else { return }
+    let state = ayuDecodeHistoryState(entry: transaction.getPreferencesEntry(key: ayuHistoryKey))
+    guard state.saveDisappearing else { return }
+    var archivedIds = Set<Int32>()
+    transaction.withAllMessages(peerId: peerId, namespace: Namespaces.Message.Cloud, { message in
+        guard let attribute = message.attributes.first(where: { $0 is EphemeralReplacementMessageAttribute }) as? EphemeralReplacementMessageAttribute,
+              attribute.state == .active,
+              attribute.replacementMessageId.peerId == peerId,
+              attribute.replacementMessageId.namespace == Namespaces.Message.EphemeralAnchored,
+              replacementIds.contains(attribute.replacementMessageId.id),
+              !archivedIds.contains(message.id.id),
+              !state.records.contains(where: { $0.kind == .deleted && $0.peerId == message.id.peerId.toInt64() && $0.messageId == message.id.id }) else { return true }
+        archivedIds.insert(message.id.id)
+        ayuArchiveMessage(transaction: transaction, mediaBox: mediaBox, message: message, kind: .deleted)
+        return true
+    })
+}
